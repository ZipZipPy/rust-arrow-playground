# Copy to .env to change the docker compose defaults. Every line is optional.

# Rows generated on the first start (the seeder skips a non-empty table).
SEED_ROWS=1000000
# Parallel COPY connections used by the seeder.
SEED_WORKERS=4

# Host port of the app: http://localhost:${APP_PORT}
APP_PORT=8080
# Upper bound of the `rows` request parameter.
MAX_ROWS=1000000
RUST_LOG=info

# Password of the compose-only database (it is not published on the host).
POSTGRES_PASSWORD=postgres
