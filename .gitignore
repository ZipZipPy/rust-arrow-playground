/exports/
*.parquet
*.arrow

# Test and browser-automation artifacts
/web/coverage/
/web/test-results/
/web/playwright-report/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
